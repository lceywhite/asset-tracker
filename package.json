{
  "name": "asset-tracker",
  "private": true,
  "version": "1.0.0-beta.1",
  "type": "module",
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "smoke": "node scripts/release0-smoke.mjs",
    "ios:add": "cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "check": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "idb": "^8.0.0",
    "pinia": "^2.1.0",
    "qrcode": "^1.5.3",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.9.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.0",
    "vite": "^8.1.4",
    "vue-eslint-parser": "^10.4.1"
  }
}
